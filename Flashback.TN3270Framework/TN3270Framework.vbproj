<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TN3270Framework</RootNamespace>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <IsTrimmable>true</IsTrimmable>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>TN3270 server-side protocol library for .NET — Telnet negotiation, 3270 data stream, and a high-level field-oriented screen API.</Description>
    <Authors>SComps</Authors>
  </PropertyGroup>

</Project>
