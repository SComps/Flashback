<Project>

  <!--
    Inject git revision metadata into every project in the repo at build time.

    AssemblyVersion      = MAJOR.MINOR.PATCH.<git-commit-count>
    FileVersion          = MAJOR.MINOR.PATCH.<git-commit-count>
    InformationalVersion = MAJOR.MINOR.PATCH+<7-char-sha>

    Each project controls its own MAJOR.MINOR.PATCH via <VersionPrefix>.
    If git is not available the commit count defaults to 0 and sha to "unknown".

    Implementation:
    We disable the SDK's auto-generation of the three version assembly attributes
    and write our own obj\GitVersionInfo.vb (or .cs) before CoreCompile so the
    compiler picks up the correct values directly.  Uses only Exec + WriteLinesToFile
    so it works on Windows, Linux (Devbox / DietPi) and macOS without changes.
  -->

  <!-- Disable SDK auto-generation of the version attributes we own -->
  <PropertyGroup>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <Target Name="GitVersion" BeforeTargets="CoreCompile">

    <!-- git rev-list: commit count (build number) -->
    <Exec Command="git rev-list --count HEAD"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitCountRaw" />
    </Exec>

    <!-- git rev-parse: short sha -->
    <Exec Command="git rev-parse --short=7 HEAD"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitShortShaRaw" />
    </Exec>

    <PropertyGroup>
      <!-- Trim whitespace / newlines that the shell appends -->
      <GitCommitCount>$(_GitCommitCountRaw.Trim())</GitCommitCount>
      <GitShortSha>$(_GitShortShaRaw.Trim())</GitShortSha>
      <!-- Fall back gracefully when git is not available -->
      <GitCommitCount Condition="'$(GitCommitCount)' == ''">0</GitCommitCount>
      <GitShortSha    Condition="'$(GitShortSha)'    == ''">unknown</GitShortSha>

      <!-- Resolve base version: VersionPrefix → Version → 1.0.0 -->
      <_BaseVersion>$(VersionPrefix)</_BaseVersion>
      <_BaseVersion Condition="'$(_BaseVersion)' == ''">$(Version)</_BaseVersion>
      <_BaseVersion Condition="'$(_BaseVersion)' == ''">1.0.0</_BaseVersion>

      <_GitAssemblyVersion>$(_BaseVersion).$(GitCommitCount)</_GitAssemblyVersion>
      <_GitInfoVersion>$(_BaseVersion)+$(GitShortSha)</_GitInfoVersion>

      <!-- Keep MSBuild properties in sync for NuGet / pack -->
      <AssemblyVersion>$(_GitAssemblyVersion)</AssemblyVersion>
      <FileVersion>$(_GitAssemblyVersion)</FileVersion>
      <InformationalVersion>$(_GitInfoVersion)</InformationalVersion>
    </PropertyGroup>

    <!-- Write assembly attributes into a generated source file in obj\ so the
         compiler sees the correct values regardless of SDK evaluation order.
         DefaultLanguageSourceExtension is .vb for VB projects, .cs for C#. -->
    <PropertyGroup>
      <_GitVersionFile>$(IntermediateOutputPath)GitVersionInfo$(DefaultLanguageSourceExtension)</_GitVersionFile>
    </PropertyGroup>

    <WriteLinesToFile File="$(_GitVersionFile)"
                      Condition="'$(DefaultLanguageSourceExtension)' == '.vb'"
                      Lines="' Auto-generated — do not edit
&lt;Assembly: System.Reflection.AssemblyVersion(&quot;$(_GitAssemblyVersion)&quot;)&gt;
&lt;Assembly: System.Reflection.AssemblyFileVersion(&quot;$(_GitAssemblyVersion)&quot;)&gt;
&lt;Assembly: System.Reflection.AssemblyInformationalVersion(&quot;$(_GitInfoVersion)&quot;)&gt;"
                      Overwrite="true" />

    <WriteLinesToFile File="$(_GitVersionFile)"
                      Condition="'$(DefaultLanguageSourceExtension)' == '.cs'"
                      Lines="// Auto-generated — do not edit
[assembly: System.Reflection.AssemblyVersion(&quot;$(_GitAssemblyVersion)&quot;)]
[assembly: System.Reflection.AssemblyFileVersion(&quot;$(_GitAssemblyVersion)&quot;)]
[assembly: System.Reflection.AssemblyInformationalVersion(&quot;$(_GitInfoVersion)&quot;)]"
                      Overwrite="true" />

    <ItemGroup>
      <Compile Include="$(_GitVersionFile)" />
    </ItemGroup>

    <Message Text="GitVersion: $(_GitAssemblyVersion) / $(_GitInfoVersion)" Importance="high" />
  </Target>

</Project>
